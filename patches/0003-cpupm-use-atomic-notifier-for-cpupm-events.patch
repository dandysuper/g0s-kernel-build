exynos-cpupm: use an atomic notifier for CPUPM/SICD notifications

exynos_cpupm_notify() used a raw notifier guarded by a shared rwlock on
every cluster/system power-mode transition (CPD, DSUPD, SICD entry and
exit), bouncing the notifier_lock cacheline across CPUs. Since the
notifier is invoked in atomic context, replace the rwlock + raw notifier
with an atomic notifier chain backed by RCU read-side traversal.

Based on commit 01b9631290 ("exynos-cpupm: Use an atomic notifier for
SICD notifications") by Sultan Alsawaf.

diff --git a/drivers/soc/samsung/exynos-cpupm.c b/drivers/soc/samsung/exynos-cpupm.c
--- a/drivers/soc/samsung/exynos-cpupm.c
+++ b/drivers/soc/samsung/exynos-cpupm.c
@@ -243,29 +243,17 @@ out:
 /******************************************************************************
  *                                    Notifier                                *
  ******************************************************************************/
-static DEFINE_RWLOCK(notifier_lock);
-static RAW_NOTIFIER_HEAD(notifier_chain);
+static ATOMIC_NOTIFIER_HEAD(notifier_chain);
 
 int exynos_cpupm_notifier_register(struct notifier_block *nb)
 {
-	unsigned long flags;
-	int ret;
-
-	write_lock_irqsave(&notifier_lock, flags);
-	ret = raw_notifier_chain_register(&notifier_chain, nb);
-	write_unlock_irqrestore(&notifier_lock, flags);
-
-	return ret;
+	return atomic_notifier_chain_register(&notifier_chain, nb);
 }
 EXPORT_SYMBOL_GPL(exynos_cpupm_notifier_register);
 
 static int exynos_cpupm_notify(int event, int v)
 {
-	int ret = 0;
-
-	read_lock(&notifier_lock);
-	ret = raw_notifier_call_chain(&notifier_chain, event, &v);
-	read_unlock(&notifier_lock);
+	int ret = atomic_notifier_call_chain(&notifier_chain, event, &v);
 
 	return notifier_to_errno(ret);
 }
